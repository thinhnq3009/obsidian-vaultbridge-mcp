VAULT_PATH=C:/Users/me/Documents/My Vault
BACKEND=filesystem
READ_ONLY=false
# Filesystem Markdown writes only; false freezes existing agents_edit_at.
AUTO_AGENT_EDIT_AT=true
# READ_PATHS=Notes,Projects
# WRITE_PATHS=Projects
INDEX_MODE=auto
WATCH_MODE=auto
# CACHE_DIR=C:/Users/me/AppData/Local/obsidian-vault-mcp
MAX_FILE_SIZE_BYTES=10485760
MAX_TREE_ENTRIES=10000
MAX_SEARCH_RESULTS=100

MCP_TRANSPORT=stdio
COLORFUL_LOGS=false
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=39145
MCP_HTTP_PATH=/mcp
# MCP_ALLOWED_HOSTS=localhost
# MCP_AUTH_TOKEN=replace-me-if-binding-outside-loopback

# Deprecated Local REST migration backend only:
# BACKEND=local-rest
# OBSIDIAN_API_KEY=replace-me
# OBSIDIAN_BASE_URL=https://127.0.0.1:27124
# OBSIDIAN_VERIFY_SSL=false

# Network HTTP only: acknowledge TLS termination at a trusted reverse proxy.
# Firewall the backend; preserve Host/Authorization/Origin; do not expose raw HTTP.
MCP_HTTP_TLS_PROXY=false
