VAULT_PATH=C:/Users/me/Documents/My Vault
BACKEND=filesystem
READ_ONLY=false
# Filesystem Markdown writes only; false freezes existing agents_edit_at.
AUTO_AGENT_EDIT_AT=true
# READ_PATHS=Notes,Projects
# WRITE_PATHS=Projects
INDEX_MODE=auto
WATCH_MODE=auto
# CACHE_DIR=C:/Users/me/AppData/Local/obsidian-vault-mcp
MAX_FILE_SIZE_BYTES=10485760
MAX_TREE_ENTRIES=10000
MAX_SEARCH_RESULTS=100

# 'npm run dev' on a source checkout starts experimental OAuth on loopback.
# 'npm run dev:stdio' (or the published CLI) retains STDIO behavior.
# Edit VAULT_PATH for your machine and set MCP_OWNER_PASSWORD below.
MCP_TRANSPORT=stdio
COLORFUL_LOGS=false
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=39145
MCP_HTTP_PATH=/mcp
# MCP_ALLOWED_HOSTS=localhost
# MCP_AUTH_TOKEN=replace-me-if-binding-outside-loopback

# Deprecated Local REST migration backend only:
# BACKEND=local-rest
# OBSIDIAN_API_KEY=replace-me
# OBSIDIAN_BASE_URL=https://127.0.0.1:27124
# OBSIDIAN_VERIFY_SSL=false

# Network HTTP only: acknowledge TLS termination at a trusted reverse proxy.
# Firewall the backend; preserve Host/Authorization/Origin; do not expose raw HTTP.
MCP_HTTP_TLS_PROXY=false

# Owner identity is bootstrapped automatically when owner-auth or explicit OAuth starts.
# Start: obsidian-vaultbridge-mcp owner-auth --vault /absolute/path/to/vault
# Normal MCP/STDIO/anonymous startup never opens this store or requires an owner.
# First-run only; keep secrets in an untracked .env. Never reset an existing owner.
# Omitted defaults: obsidian-admin / admin39145 (public, insecure; rotate locally
# before OAuth grants or MCP vault access are permitted).
# MCP_OWNER_USERNAME=obsidian-admin
# MCP_OWNER_PASSWORD=YOUR_UNIQUE_STRONG_PASSWORD (12-128 chars, mixed character classes)
MCP_OWNER_PORT=39146
MCP_AUTH_LOGIN_MAX_FAILURES=5
MCP_AUTH_LOGIN_WINDOW_SECONDS=900
# npm run dev sets local OAuth defaults (issuer http://127.0.0.1:39145/api/auth).
# For ChatGPT via ONE public HTTPS tunnel to 127.0.0.1:39145, set:
# MCP_OAUTH_ISSUER=https://your-tunnel-host/api/auth
# MCP_HTTP_TLS_PROXY=true
# MCP_ALLOWED_HOSTS=your-tunnel-host
# MCP_VAULT_ID=stable-local-vault-id
# Never tunnel the owner UI on port 39146.
# Experimental OAuth: default-off for normal CLI/production pending issue #60.
# MCP_AUTH_MODE=oauth
# MCP_OAUTH_ENABLED=false
# MCP_OAUTH_ISSUER=https://your-host/api/auth
# MCP_VAULT_ID=stable-local-vault-id
# MCP_OWNER_PORT=39146
# MCP_AUTH_DIRECTORY=/absolute/private/app-data
# MCP_ALLOW_UNAUTHENTICATED_NETWORK=false
# MCP_RATE_LIMIT_RPM=1200
# MCP_RATE_LIMIT_BURST=120
# MCP_MAX_CONCURRENT=32
# MCP_AUTHENTICATED_CLIENT_RPM=600
# MCP_UNAUTHENTICATED_ATTEMPT_RPM=60
# MCP_OAUTH_ENDPOINT_RPM=60
