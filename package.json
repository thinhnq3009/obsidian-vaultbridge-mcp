{
  "name": "obsidian-vaultbridge-mcp",
  "version": "0.1.0-alpha.1",
  "description": "Connect AI agents to your Obsidian vault through MCP. Early preview with a standalone filesystem backend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "obsidian-vaultbridge-mcp": "./dist/index.js",
    "obsidian-local-rest-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    ".env.example",
    "RELEASING.md"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test -- --maxWorkers=2 && npm run smoke:package && npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "smoke:package": "tsx scripts/smoke-package.ts"
  },
  "keywords": [
    "codex",
    "mcp",
    "obsidian",
    "filesystem",
    "standalone",
    "vault",
    "typescript"
  ],
  "author": "thinhnq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinhnq3009/obsidian-vaultbridge-mcp.git"
  },
  "homepage": "https://github.com/thinhnq3009/obsidian-vaultbridge-mcp#readme",
  "bugs": {
    "url": "https://github.com/thinhnq3009/obsidian-vaultbridge-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "proper-lockfile": "^4.1.2",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.7",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.7.2",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
