{
  "name": "obsidian-vaultbridge-mcp",
  "version": "0.1.0",
  "description": "Connect AI agents to your Obsidian vault through a standalone, local-first MCP filesystem server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "obsidian-vaultbridge-mcp": "./dist/index.js",
    "obsidian-local-rest-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    ".env.example",
    "RELEASING.md"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "dev": "tsx watch --clear-screen=false scripts/dev-oauth.ts",
    "dev:oauth": "tsx watch --clear-screen=false scripts/dev-oauth.ts",
    "dev:stdio": "tsx watch --clear-screen=false src/index.ts --stdio",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test -- --maxWorkers=2 && npm run smoke:package && npm audit --omit=dev --audit-level=high",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "smoke:package": "tsx scripts/smoke-package.ts",
    "smoke:oauth": "tsx scripts/local-e2e.mjs",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "preview:web": "npm --prefix web run preview",
    "verify:web": "node scripts/verify-owner-ui.mjs",
    "verify:owner-ui": "node scripts/verify-owner-auth-ui.mjs"
  },
  "keywords": [
    "codex",
    "mcp",
    "obsidian",
    "filesystem",
    "standalone",
    "vault",
    "typescript"
  ],
  "author": "thinhnq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinhnq3009/obsidian-vaultbridge-mcp.git"
  },
  "homepage": "https://github.com/thinhnq3009/obsidian-vaultbridge-mcp#readme",
  "bugs": {
    "url": "https://github.com/thinhnq3009/obsidian-vaultbridge-mcp/issues"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.16",
    "@better-auth/mcp": "1.7.16",
    "@better-auth/oauth-provider": "1.7.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-auth": "1.7.16",
    "chokidar": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "proper-lockfile": "^4.1.2",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/express": "^5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "^10.2.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.68.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
